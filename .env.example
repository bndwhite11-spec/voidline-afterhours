# Runtime-only values. Never commit a populated .env/.dev.vars file.
# Configure in Sites runtime variables, not .openai/hosting.json.
GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-web-oauth-client-secret
VOIDLINE_ORIGIN=https://voidline-afterhours.pipedcactus1.chatgpt.site
# Optional encrypted transport. This must be one trusted HTTPS homeserver origin.
# It is not a substitute for Google credentials or verified device enrollment.
MATRIX_HOMESERVER=https://matrix.example.com
