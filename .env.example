# The existing Sites D1 binding DB provides persistent native accounts.
# Native account creation/login needs no provider or mail secret.
# Set populated values ONLY in the host's server-side secret store.
# Keep .env/.dev.vars and every credential out of Git and browser assets.

# Exact canonical HTTPS origin (no path, query or trailing slash).
# Needed for Google callbacks, verified email and a stable WebAuthn RP origin.
# VOIDLINE_ORIGIN=https://your-app.example

# Optional genuine Google OpenID Connect. Both secrets and VOIDLINE_ORIGIN
# required. Authorize <VOIDLINE_ORIGIN>/api/auth/google/callback in Google.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Optional verified email/password reset via Resend's HTTPS API.
# Verify the sending domain and DNS with Resend before enabling.
# RESEND_API_KEY=
# EMAIL_FROM=Voidline <accounts@your-verified-domain.example>

# One-time platform owner binding, after authenticated account claim + passkey.
# See docs/OWNER-BOOTSTRAP.md. @xrp alone never grants platform authority.
# PLATFORM_OWNER_ACCOUNT_ID=
# OWNER_BOOTSTRAP_TOKEN=

# Optional encrypted messaging: separate trusted HTTPS Matrix origin.
# Leaving this unset does not prevent creating a Voidline account.
# MATRIX_HOMESERVER=https://matrix.example.com

# Optional normal-account encrypted enrollment through Synapse JWT login.
# Requires a separately operated service with org.matrix.login.jwt enabled.
# Read docs/ENCRYPTED-SETUP.md before enabling; these belong only in server secrets.
# Matrix server_name is immutable and may differ from its HTTPS API hostname.
# MATRIX_SERVER_NAME=messages.example.com
# Must match jwt_config.audiences and jwt_config.issuer on Synapse exactly.
# MATRIX_JWT_AUDIENCE=voidline
# MATRIX_JWT_SECRET=
# Set only after the operator reserved the v_ native-account namespace and
# prevented unrelated password/public-registration/SSO accounts claiming it.
# MATRIX_JWT_NAMESPACE_RESERVED=1

# Optional generic Web Push for native account activity, using RFC8291/VAPID.
# Never expose or commit VAPID_PRIVATE_KEY. Keep it in the server secret store.
# The public key is intentionally returned to authenticated browsers.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=https://your-app.example/help.html

# Optional native account lifecycle reconciliation, supported Synapse admin APIs.
# Separate, narrowly protected server-only token. This never grants message keys.
# MATRIX_ADMIN_TOKEN=

# Private Site MCP operator: exact Site-scoped authenticated caller ID resolved
# with operation_identity and bound through trusted Sites runtime administration.
# This is a bounded service operator, NOT the native platform-owner account.
# VOIDLINE_SERVICE_OAI_ID=

# Protected hosted D1 snapshots in private R2 MEDIA storage. Base64 raw32-byte
# AES key; preserve an independent offline copy in an operator secret manager.
# VOIDLINE_BACKUP_KEY=
