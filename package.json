{
  "name": "voidline-afterhours",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "build": "node scripts/prepare-native-downloads.mjs && node scripts/build-app-icons.mjs --check && node scripts/build-security.mjs && node scripts/build-crypto.mjs && node scripts/build-media.mjs && node scripts/build-profile-images.mjs && node scripts/build-art.mjs --require-web-sources && node scripts/build-worker.mjs",
    "dev": "node scripts/dev-worker.mjs",
    "db:generate": "drizzle-kit generate",
    "test:foundation": "node backend/auth-test.mjs && node backend/foundation-review-test.mjs",
    "test:server": "node backend/run.mjs",
    "test:client": "node tests/run.cjs",
    "check:restore": "python3 backend/backup-test.py"
  },
  "devDependencies": {
    "drizzle-kit": "0.31.10",
    "drizzle-orm": "0.45.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "wrangler": "4.92.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@noble/hashes": "2.4.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "@sindresorhus/gifkit": "0.1.1",
    "dompurify": "3.4.18",
    "esbuild": "0.25.12",
    "fast-png": "8.0.0",
    "jose": "6.2.17",
    "libheif-js": "1.23.5",
    "matrix-js-sdk": "45.1.0",
    "tiff": "7.1.3"
  }
}
